# CareCircle Environment Configuration

# Passcode Security Secrets
SESSION_SECRET=carecircle-super-secret-key-32chars-long-min

# Email Notification Provider (Resend / Mock)
# If RESEND_API_KEY is not provided, the platform automatically logs notifications to an audit stream
RESEND_API_KEY=
CARE_NOTIFICATION_EMAIL=alerts@carecircle.health

# Optional: Google Gemini API Key for Multimodal Pill Verification Lens
GEMINI_API_KEY=
